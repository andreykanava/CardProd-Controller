# WG IP твоего proxy (он тоже join’ится и получает IP из 10.50.0.0/24)
EDGE_WG_IP=10.50.0.2

# порт proxy-agent (FastAPI) на proxy
EDGE_AGENT_PORT=8081

# токен для proxy-agent
EDGE_AGENT_TOKEN=supersecret

# если хочешь, чтобы контроллер мог вызывать /ports на нодах
NODE_PORTMAP_TOKENS='{"node-1":"node-secret-1","node-2":"node-secret-2"}'
